{
  "redirects": [
    {
      "source": "/lp",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/lp/(.*)",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/m",
      "destination": "/mobility.html"
    },
    {
      "source": "/m/(.*)",
      "destination": "/mobility.html"
    },
    {
      "source": "/manual",
      "destination": "https://nodecloud-manual.vercel.app/manual"
    },
    {
      "source": "/manual/(.*)",
      "destination": "https://nodecloud-manual.vercel.app/manual/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
