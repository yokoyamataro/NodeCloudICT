{
  "name": "nodecloud-design",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "scout:parcel-maps": "node scripts/scout-parcel-maps.mjs",
    "sync:parcel-maps": "node scripts/sync-parcel-maps.mjs",
    "ios:sync": "cp capacitor.config.ios.ts capacitor.config.ts && npm run build && npx cap sync ios && node -e \"const f='ios-ict/App/App/capacitor.config.json';const fs=require('fs');const j=JSON.parse(fs.readFileSync(f));if(!j.packageClassList.includes('DroggerLocationPlugin'))j.packageClassList.push('DroggerLocationPlugin');fs.writeFileSync(f,JSON.stringify(j,null,2));\" && cp capacitor.config.android.ts capacitor.config.ts"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "^1.2.26",
    "@capacitor/android": "8.3.1",
    "@capacitor/cli": "8.3.1",
    "@capacitor/core": "8.3.1",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/ios": "^8.3.1",
    "@supabase/supabase-js": "^2.99.0",
    "@types/delaunator": "^5.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "delaunator": "^5.1.0",
    "docxtemplater": "^3.69.0",
    "encoding-japanese": "^2.2.0",
    "exceljs": "^4.4.0",
    "leaflet": "^1.9.4",
    "leaflet-rotate": "^0.2.8",
    "lucide-react": "^0.577.0",
    "pdfjs-dist": "^6.0.227",
    "pizzip": "^3.2.0",
    "polylabel": "^2.1.0",
    "proj4": "^2.20.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-image-crop": "^11.0.10",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.13.1",
    "tailwind-merge": "^3.5.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
